# Copy to /srv/crb-ot-clinic/.env on the server (chmod 600). Never commit the real file.
# Generate secrets with the commands shown; hex keeps them URL-safe.

# Public hostname. Caddy gets a certificate for it; the app is served at https://$DOMAIN.
DOMAIN=crbotclinic.com
# Let's Encrypt account email, for expiry notices.
ACME_EMAIL=owner@example.com

# Images pushed by CI. APP_TAG is set by the deploy job to the commit SHA.
APP_IMAGE=ghcr.io/christianrazul/crb-ot-clinic-new
APP_TAG=latest

# openssl rand -hex 24
POSTGRES_PASSWORD=
# openssl rand -base64 32
BETTER_AUTH_SECRET=
# openssl rand -hex 32
CRON_SECRET=

# Password reset emails.
SMTP_URL=smtps://user:password@smtp.example.com:465
EMAIL_FROM=CRB OT Clinic <no-reply@example.com>

# First start on an empty database: creates the main branch and the owner's
# account, then emails the owner a link to set a password. Remove after.
BOOTSTRAP_OWNER_EMAIL=owner@example.com
BOOTSTRAP_OWNER_NAME=Camelia Boquia
BOOTSTRAP_BRANCH_NAME=CRB Bangkal
BOOTSTRAP_BRANCH_LOCATION=Davao City

# Backups (restic). Leave RESTIC_REPOSITORY empty to keep them in
# /srv/crb-ot-clinic/backups on this server; set an S3-compatible bucket
# (Backblaze B2, Wasabi...) to keep them off-site, e.g.
# RESTIC_REPOSITORY=s3:https://s3.us-west-004.backblazeb2.com/crb-backups
RESTIC_REPOSITORY=
# openssl rand -base64 32. Store a copy offline: without it the backups cannot be read.
RESTIC_PASSWORD=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
