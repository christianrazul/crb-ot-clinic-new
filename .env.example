# Copy to .env and adjust. Every variable is validated at boot by src/env.schema.ts.

# Postgres from docker-compose.dev.yml
DATABASE_URL=postgres://crb:crb@localhost:5433/crb

# Public URL the app is served from
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Signs sessions and tokens. Generate your own: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-me-with-the-output-of-openssl-rand-base64-32

# SMTP for password reset emails. Leave unset in development: emails are logged to the console.
# SMTP_URL=smtps://user:password@smtp.example.com:465
# EMAIL_FROM=CRB OT Clinic <no-reply@example.com>

# Show the "Preview as" role switcher in the sidebar (development only)
NEXT_PUBLIC_DEV_ROLE_SWITCHER=true

# Password for the seeded demo accounts (development only)
SEED_PASSWORD=crb-demo-password
